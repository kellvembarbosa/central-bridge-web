{
  "name": "@central/bridge-web",
  "version": "1.2.0",
  "description": "Central Bridge (contract v1) on Web standards: signed admin API (HMAC), invoicing and checkout client for Cloudflare Workers, Vercel, Astro, Next.js, TanStack Start and SvelteKit.",
  "type": "module",
  "license": "MIT",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc --noEmit",
    "test": "node --test --test-reporter=spec tests/*.spec.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "test:workerd": "node tests/workerd/run.mjs"
  },
  "devDependencies": {
    "@types/node": "~25.6.0",
    "typescript": "~6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kellvembarbosa/central-bridge-web.git"
  }
}
